# Database — SQLite for local dev (zero setup). For Postgres prod, change
# `provider = "postgresql"` in prisma/schema.prisma and set a Postgres URL.
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-only-change-me-please-32-chars-min-xxxxxxxxxxxxxx"

# App
APP_BASE_DOMAIN="localhost:3000"
APP_PROTOCOL="http"

# Email — Resend (optional; if unset, emails are persisted + logged, never actually sent)
RESEND_API_KEY=""

# AI copy assistant (optional) — leave empty to use deterministic templates.
# Resolution order: Paperclip agent → Anthropic → deterministic fallback.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Paperclip AI engine (optional) — power AI copywriting with a Paperclip
# "Copywriter" agent. If unset, falls through to Anthropic / fallback.
# PAPERCLIP_API_URL="http://192.168.1.241:3100"
# PAPERCLIP_BOARD_TOKEN=""
# PAPERCLIP_COPYWRITER_COMPANY_ID=""
# PAPERCLIP_COPYWRITER_AGENT_ID=""
# PAPERCLIP_COPY_TIMEOUT_MS="90000"

DEFAULT_FROM_EMAIL="noreply@launchstack.local"
DEFAULT_FROM_NAME="Launchstack"
