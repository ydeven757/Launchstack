# ───────── Launchstack production env ─────────
# Copy to .env.production and fill in real values. Never commit secrets.

# Postgres (used by docker-compose)
POSTGRES_USER=launchstack
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=launchstack

# Public URL
NEXTAUTH_URL=https://app.example.com
APP_BASE_DOMAIN=app.example.com
APP_PROTOCOL=https

# Strong secrets — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-64-char-hex-or-base64
ENCRYPTION_KEY=replace-with-exactly-64-hex-chars

# Email (Resend) — leave empty for mock-mode in production
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@launchstack.app
DEFAULT_FROM_NAME=Launchstack

# AI copy assistant — leave empty for deterministic template fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Seed demo data on first boot only — set to 0 after initial deploy
RUN_SEED=0
